# Copy to `.env.local` and fill in. Never commit real values — `.env*` is gitignored.

# Public site origin. Used for canonical URLs, Open Graph tags, sitemap and robots.
# Must be present at BUILD time — next build inlines it. Setting it only for
# `npm start` leaves the prerendered sitemap pointing at localhost.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL if omitted.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery (Resend). If any of the three are missing, the API
# responds 503 and the form falls back to a mailto: link, so the site still works.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
